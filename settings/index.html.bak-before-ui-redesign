  _switchDeviceChanged: async function() {
    var devId = el('t-switch') && el('t-switch').value;
    var wrap  = el('t-sw-mappings');
    if (!wrap) return;
    if (!devId) { wrap.innerHTML = ''; return; }
    var device = State.devices.find(function(d){ return d.id === devId; });
    if (!device) { wrap.innerHTML = ''; return; }

    var editingId = TModal._editingGroup ? TModal._editingGroup.id : null;
    var groups = computeGroups().groups.filter(function(g){ return g.id !== editingId && g.type !== 'switch'; });
    var groupOpts = groups.map(function(g){
      return '<option value="' + esc(g.id) + '">' + esc(g.name || 'Automation') + '</option>';
    }).join('');

    // Try standard capability rows first
    var rows = [];
    var caps = device.capabilities || [];
    if (caps.indexOf('onoff') !== -1) {
      rows.push({ triggerType: 'switch_on',    cap: 'onoff',  label: 'When switched ON'  });
      rows.push({ triggerType: 'switch_off',   cap: 'onoff',  label: 'When switched OFF' });
    }
    if (caps.indexOf('button') !== -1) {
      rows.push({ triggerType: 'button_press', cap: 'button', label: 'Button press'      });
    }
    caps.filter(function(c){ return /^button\./.test(c); }).sort().forEach(function(c) {
      rows.push({ triggerType: 'button_key', cap: c, label: 'Button ' + c.replace('button.', '') });
    });

    if (rows.length) {
      TModal._switchRenderRows(rows, groupOpts, false);
      return;
    }

    // No standard caps — fetch Flow trigger cards via app API
    wrap.innerHTML = '<p style="color:#8e8e93;font-size:13px;padding:6px 0">Loading buttons…</p>';
    try {
      var res = await window._hBridge('_flowTriggersReq', '_flowTriggersResult', { deviceId: devId });
      if (res.error) {
        wrap.innerHTML = '<p style="color:#ff3b30;font-size:13px">Error: ' + esc(res.error) + '<br>Check Logs tab for details.</p>';
        return;
      }
      if (!res.cards || !res.cards.length) {
        wrap.innerHTML = '<p style="color:#ff3b30;font-size:13px">No trigger cards found for this device.<br>Check Logs tab for details.</p>';
        return;
      }
      var flowRows = res.cards.map(function(c) {
        return { triggerType: 'flow_card', triggerId: c.id, triggerUri: c.uri, label: c.title, args: c.args };
      });
      TModal._switchRenderRows(flowRows, groupOpts, true);
    } catch(e) {
      wrap.innerHTML = '<p style="color:#ff3b30;font-size:13px">Error loading buttons: ' + esc(e.message) + '</p>';
    }
  },

  _switchRenderRows: function(rows, groupOpts, isFlowMode) {
    var wrap = el('t-sw-mappings');
    if (!wrap) return;
    var html = '<div class="sec-hdr" style="margin-top:12px">Button → Automation mapping</div>';
    if (isFlowMode) {
      html += '<p style="color:#8e8e93;font-size:12px;margin-bottom:8px">Homey Flows will be created automatically when you save.</p>';
    }
    rows.forEach(function(r, i) {
      html += '<div class="fgrp">' +
        '<label class="flabel">' + esc(r.label) + '</label>' +
        '<select class="finput" id="t-sw-map-' + i + '" ' +
          'data-trigger-type="' + esc(r.triggerType) + '" ' +
          'data-cap="' + esc(r.cap || '') + '" ' +
          'data-trigger-id="' + esc(r.triggerId || '') + '" ' +
          'data-trigger-uri="' + esc(r.triggerUri || '') + '" ' +
          'data-trigger-title="' + esc(r.label) + '">' +
          '<option value="">— no action —</option>' + groupOpts +
        '</select></div>';
    });
    wrap.innerHTML = html;
  },

  _saveSwitch: async function() {
    var swDev = el('t-switch') && el('t-switch').value;
    if (!swDev) throw new Error('Please select a switch or button device');
    var name = (el('t-name') && el('t-name').value.trim()) || 'Wall Switch';
    var gid  = TModal._editingGroup ? TModal._editingGroup.id : TModal._mkId();
    var list = [];
    var isFlowMode = false;
    var flowMappings = [];
    var i = 0;

    while (el('t-sw-map-' + i)) {
      var sel     = el('t-sw-map-' + i);
      var groupId = sel.value;
      var trigType = sel.getAttribute('data-trigger-type');

      if (trigType === 'flow_card') {
        isFlowMode = true;
        if (groupId) {
          var grp = computeGroups().groups.find(function(g){ return g.id === groupId; });
          flowMappings.push({
            triggerId:    sel.getAttribute('data-trigger-id'),
            triggerUri:   sel.getAttribute('data-trigger-uri'),
            triggerTitle: sel.getAttribute('data-trigger-title') || '',
            triggerArgs:  {},
            groupId:      groupId,
            groupName:    grp ? (grp.name || 'Automation') : groupId
          });
        }
      } else if (groupId) {
        var cap = sel.getAttribute('data-cap');
        var trigger = { type: trigType, deviceId: swDev };
        if (trigType === 'button_key')        trigger.capability = cap;
        if (trigType === 'device_capability') { trigger.capability = cap; trigger.value = true; }
        list.push({
          id: TModal._mkId(), name: name, enabled: true,
          _groupId: gid, _groupName: name, _templateType: 'switch',
          trigger: trigger, conditions: [],
          actions: [{ type: 'run_group', groupId: groupId }]
        });
      }
      i++;
    }

    if (isFlowMode) {
      if (!flowMappings.length) throw new Error('Please map at least one button to an automation');
      var existingFlowIds = TModal._editingGroup && TModal._editingGroup._homeyFlowIds || [];
      var result = await window._hBridge('_flowSyncReq', '_flowSyncResult', {
        deviceId: swDev, mappings: flowMappings, existingFlowIds: existingFlowIds
      }, 20000);
      // Store as a single virtual automation entry (no direct trigger — Flows handle it)
      list.push({
        id: TModal._mkId(), name: name, enabled: true,
        _groupId: gid, _groupName: name, _templateType: 'switch',
        _useHomeyFlows: true, _homeyFlowIds: result.flowIds || [],
        _switchDeviceId: swDev, _switchMappings: flowMappings,
        trigger: { type: 'homey_flow', deviceId: swDev },
        conditions: [], actions: []
      });
    }

    if (!list.length) throw new Error('Please map at least one button to an automation');
    return list;
  }
};

// ── Custom (advanced) editor ────────────────────────────────────────────────────
var CustomEditor = {
  idx: -1, conds: [], acts: [],

  open: function(i) {
    CustomEditor.idx   = (i === undefined) ? -1 : i;
    CustomEditor.conds = [];
    CustomEditor.acts  = [];
    var a = (CustomEditor.idx >= 0) ? State.automations[CustomEditor.idx] : {};

    el('tmpl-title').textContent = CustomEditor.idx >= 0 ? '⚙️ Edit Automation' : '⚙️ Custom Automation';
    el('tmpl-save-btn').textContent = CustomEditor.idx >= 0 ? 'Save' : 'Add';
    CustomEditor.conds = JSON.parse(JSON.stringify(a.conditions || []));
    CustomEditor.acts  = JSON.parse(JSON.stringify(a.actions    || []));
    el('tmpl-body').innerHTML = CustomEditor._form(a);
    el('tmpl-overlay').classList.add('on');
    TModal.type = 'custom';
  },

  _form: function(a) {
    var t = a.trigger || {};
    var trigType = t.type || 'motion_start';
    var sensors = State.devices.filter(function(d) {
      return d.capabilities && (d.capabilities.indexOf('alarm_motion') !== -1 || d.capabilities.indexOf('alarm_contact') !== -1);
    });
    var sensorOpts = sensors.map(function(d) {
      return '<option value="'+esc(d.id)+'"'+(d.id===t.deviceId?' selected':'')+'>'+esc(d.name)+(d.zone?' ('+esc(d.zone)+')':'')+' ['+esc(d.class||'')+']</option>';
    }).join('');
    var allOpts = State.devices.map(function(d) {
      return '<option value="'+esc(d.id)+'"'+(d.id===t.deviceId?' selected':'')+'>'+esc(d.name)+(d.zone?' ('+esc(d.zone)+')':'')+' ['+esc(d.class||'')+']</option>';
    }).join('');

    var html = '<div class="fgrp"><label class="flabel">Name</label><input class="finput" id="ce-name" value="'+esc(a.name||'')+'"/></div>' +
      '<div class="fgrp"><label class="flabel">Trigger type</label>' +
        '<select class="finput" id="ce-trig-type" onchange="CustomEditor._trigChanged()">' +
          '<option value="motion_start"'+(trigType==='motion_start'?' selected':'')+'>Motion detected</option>' +
          '<option value="motion_stop"'+(trigType==='motion_stop'?' selected':'')+'>Motion stopped</option>' +
          '<option value="door_open"'+(trigType==='door_open'?' selected':'')+'>Door opens</option>' +
          '<option value="door_close"'+(trigType==='door_close'?' selected':'')+'>Door closes</option>' +
          '<option value="time"'+(trigType==='time'?' selected':'')+'>Every day at time</option>' +
        '</select></div>' +
      '<div id="ce-trig-extra"></div>' +
      '<hr class="sep">' +
      '<div style="font-size:11px;font-weight:700;color:#8e8e93;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Conditions (optional)</div>' +
      '<div id="ce-conds"></div>' +
      '<button style="width:100%;padding:8px;border:1.5px dashed #c7c7cc;border-radius:8px;background:none;color:#8e8e93;cursor:pointer;font-size:13px;margin-bottom:12px" onclick="CustomEditor._addCond()">+ Add condition</button>' +
      '<hr class="sep">' +
      '<div style="font-size:11px;font-weight:700;color:#8e8e93;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Actions</div>' +
      '<div id="ce-acts"></div>' +
      '<button style="width:100%;padding:8px;border:1.5px dashed #c7c7cc;border-radius:8px;background:none;color:#8e8e93;cursor:pointer;font-size:13px" onclick="CustomEditor._addAct()">+ Add action</button>';

    setTimeout(function() {
      CustomEditor._trigChanged(a.trigger);
      CustomEditor._renderConds();
      CustomEditor._renderActs();
    }, 0);
    return html;
  },

  _trigChanged: function(existing) {
    existing = existing || {};
    var type = el('ce-trig-type') ? el('ce-trig-type').value : 'motion_start';
    var allOpts = State.devices.map(function(d) {
      return '<option value="'+esc(d.id)+'"'+(d.id===existing.deviceId?' selected':'')+'>'+esc(d.name)+(d.zone?' ('+esc(d.zone)+')':'')+' ['+esc(d.class||'')+']</option>';
    }).join('');
    var extra = '';
    if (type === 'time') {
      extra = '<div class="fgrp"><label class="flabel">Time</label><input class="finput" type="text" pattern="\d{2}:\d{2}" placeholder="HH:MM" id="ce-t-time" value="'+(existing.time||'08:00')+'"/></div>';
    } else {
      extra = '<div class="fgrp"><label class="flabel">Device</label><select class="finput" id="ce-t-dev"><option value="">— Select —</option>'+allOpts+'</select></div>';
    }
    if (el('ce-trig-extra')) el('ce-trig-extra').innerHTML = extra;
  },

  _getTrigger: function() {
    var type = el('ce-trig-type').value;
    if (type === 'time') return { type: type, time: (el('ce-t-time')||{}).value||'' };
    return { type: type, deviceId: (el('ce-t-dev')||{}).value||'' };
  },

  _renderConds: function() {
    if (!el('ce-conds')) return;
    el('ce-conds').innerHTML = CustomEditor.conds.map(function(c, i) {
      if (c.type === 'time_between') {
        return '<div class="fgrp" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">' +
          '<span style="font-size:13px;color:#8e8e93">Between</span>' +
          '<input type="text" pattern="\d{2}:\d{2}" placeholder="HH:MM" style="border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" value="'+(c.from||'08:00')+'" oninput="CustomEditor.conds['+i+'].from=this.value"/>' +
          '<span style="font-size:13px;color:#8e8e93">and</span>' +
          '<input type="text" pattern="\d{2}:\d{2}" placeholder="HH:MM" style="border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" value="'+(c.to||'22:00')+'" oninput="CustomEditor.conds['+i+'].to=this.value"/>' +
          '<button onclick="CustomEditor._rmCond('+i+')" style="background:none;border:none;color:#ff3b30;cursor:pointer;font-size:18px">×</button>' +
        '</div>';
      }
      return '';
    }).join('');
  },

  _addCond: function() {
    CustomEditor.conds.push({ type: 'time_between', from: '08:00', to: '22:00' });
    CustomEditor._renderConds();
  },
  _rmCond: function(i) { CustomEditor.conds.splice(i,1); CustomEditor._renderConds(); },

  _renderActs: function() {
    if (!el('ce-acts')) return;
    var allOpts = function(selId) {
      return State.devices.map(function(d) {
        return '<option value="'+esc(d.id)+'"'+(d.id===selId?' selected':'')+'>'+esc(d.name)+(d.zone?' ('+esc(d.zone)+')':'')+' ['+esc(d.class||'')+']</option>';
      }).join('');
    };
    el('ce-acts').innerHTML = CustomEditor.acts.map(function(a, i) {
      var typeOpts = [['turn_on','Turn ON'],['turn_off','Turn OFF'],['set_dim','Set brightness'],
        ['set_color_temp','Set color temp'],['notify','Notification'],['wait','Wait (seconds)']].map(function(p) {
        return '<option value="'+p[0]+'"'+(a.type===p[0]?' selected':'')+'>'+p[1]+'</option>';
      }).join('');
      var extra = '';
      switch(a.type) {
        case 'turn_on': case 'turn_off':
          extra = '<select style="flex:1;border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" onchange="CustomEditor.acts['+i+'].deviceId=this.value"><option value="">— Device —</option>'+allOpts(a.deviceId)+'</select>'; break;
        case 'set_dim': case 'set_color_temp':
          extra = '<select style="flex:1;border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" onchange="CustomEditor.acts['+i+'].deviceId=this.value"><option value="">— Device —</option>'+allOpts(a.deviceId)+'</select>' +
            '<input type="number" min="0" max="1" step="0.05" value="'+(a.value!=null?a.value:1)+'" style="width:65px;border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" oninput="CustomEditor.acts['+i+'].value=parseFloat(this.value)"/>'; break;
        case 'notify':
          extra = '<input type="text" value="'+esc(a.message||'')+'" placeholder="Message" style="flex:1;border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" oninput="CustomEditor.acts['+i+'].message=this.value"/>'; break;
        case 'wait':
          extra = '<input type="number" min="1" value="'+(a.seconds||5)+'" style="width:70px;border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" oninput="CustomEditor.acts['+i+'].seconds=parseInt(this.value)"/> <span style="font-size:13px;color:#8e8e93">sec</span>'; break;
      }
      return '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#f2f2f7;border-radius:10px;padding:10px;margin-bottom:8px">' +
        '<select style="border:1.5px solid #e0e0e5;border-radius:8px;padding:6px;font-size:13px" onchange="CustomEditor._actType('+i+',this.value)">'+typeOpts+'</select>' +
        extra +
        '<button onclick="CustomEditor._rmAct('+i+')" style="background:none;border:none;color:#ff3b30;cursor:pointer;font-size:20px;margin-left:auto">×</button>' +
      '</div>';
    }).join('');
  },

  _addAct: function() { CustomEditor.acts.push({ type:'turn_on', deviceId:'' }); CustomEditor._renderActs(); },
  _rmAct: function(i) { CustomEditor.acts.splice(i,1); CustomEditor._renderActs(); },
  _actType: function(i, type) {
    var prev = CustomEditor.acts[i];
    var n = { type: type };
    if (type !== 'notify' && type !== 'wait') n.deviceId = prev.deviceId || '';
    if (type === 'set_dim' || type === 'set_color_temp') n.value = 1;
    if (type === 'notify') n.message = '';
    if (type === 'wait') n.seconds = 5;
    CustomEditor.acts[i] = n;
    CustomEditor._renderActs();
  },

  save: async function() {
    var name = el('ce-name').value.trim();
    if (!name) { window._hAlert('Please enter a name.'); return; }
    if (!CustomEditor.acts.length) { window._hAlert('Add at least one action.'); return; }
    var auto = {
      id: (CustomEditor.idx >= 0 && State.automations[CustomEditor.idx].id) || TModal._mkId(),
      name: name, enabled: CustomEditor.idx >= 0 ? State.automations[CustomEditor.idx].enabled : true,
      trigger: CustomEditor._getTrigger(),
      conditions: JSON.parse(JSON.stringify(CustomEditor.conds)),
      actions: JSON.parse(JSON.stringify(CustomEditor.acts))
    };
    if (CustomEditor.idx >= 0) { State.automations[CustomEditor.idx] = auto; }
    else { State.automations.push(auto); }
    TModal.close();
    await AutoList.persist('Saved');
  }
};

// ── Override modal ──────────────────────────────────────────────────────────────
var OverrideModal = {
  _gid: null,

  openByIndex: function(gi) {
    var computed = computeGroups();
    var g = computed.groups[gi];
    if (!g) return;
    OverrideModal.open(g.id, g.name || 'Automation');
  },

  open: function(gid, name) {
    this._gid = gid;
    el('ov-title').textContent = '⏸  ' + (name || 'Automation');
    var expiresAt = (State.overrides || {})[gid];
    var hasActive = expiresAt && Date.now() < expiresAt;
    if (hasActive) {
      var rem  = expiresAt - Date.now();
      var h    = Math.floor(rem / 3600000);
      var m    = Math.floor((rem % 3600000) / 60000);
      var disp = h > 0 ? h + 'h ' + m + 'm remaining' : m + 'm remaining';
      el('ov-active-label').textContent = '⏸ Override active — ' + disp;
      el('ov-resume-wrap').style.display = '';
    } else {
      el('ov-resume-wrap').style.display = 'none';
    }
    el('ov-overlay').classList.add('on');
  },

  bgClose: function(e) { if (e.target === el('ov-overlay')) this.close(); },
  close:   function()  { el('ov-overlay').classList.remove('on'); },

  set: function(mins) {
    var expiresAt = Date.now() + mins * 60 * 1000;
    var ov = Object.assign({}, State.overrides || {});
    ov[this._gid] = expiresAt;
    State.overrides = ov;
    window._hSet('_overrides', JSON.stringify(ov)).catch(function(){});
    this.close();
    Countdown.tick();
  },

  setMidnight: function() {
    var now = new Date();
    var midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0).getTime();
    var ov = Object.assign({}, State.overrides || {});
    ov[this._gid] = midnight;
    State.overrides = ov;
    window._hSet('_overrides', JSON.stringify(ov)).catch(function(){});
    this.close();
    Countdown.tick();
  },

  cancel: function() {
    var ov = Object.assign({}, State.overrides || {});
    delete ov[this._gid];
    State.overrides = ov;
    window._hSet('_overrides', JSON.stringify(ov)).catch(function(){});
    this.close();
    Countdown.tick();
  }
};

