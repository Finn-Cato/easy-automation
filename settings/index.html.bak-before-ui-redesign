        if (TModal._lightDims[id].on == null) TModal._lightDims[id].on = globalVal / 100;
        if (TModal._prevGlobal.on == null) TModal._prevGlobal.on = globalVal;
        var pct = Math.round(TModal._lightDims[id].on * 100);
        var sid = did + '_on', vid = sid + '_v';
        html += '<div class="lt-row">' +
          '<span class="lt-label">💡 ON</span>' +
          '<div class="slider-row" style="flex:1;margin-top:0">' +
            '<input type="range" id="' + sid + '" min="1" max="100" value="' + pct + '"' +
              ' oninput="document.getElementById(\'' + vid + '\').textContent=this.value+\'%\';TModal._setLightDim(' + JSON.stringify(id) + ',\'on\',parseInt(this.value))">' +
            '<span class="slider-val" id="' + vid + '">' + pct + '%</span>' +
          '</div></div>';
      }
      html += '</div>';
