// ── Group automations by _groupId ──────────────────────────────────────────────
function computeGroups() {
  var byId = {}, order = [], orphans = [];
  State.automations.forEach(function(a, i) {
    if (a._groupId) {
      if (!byId[a._groupId]) { byId[a._groupId] = { id: a._groupId, type: a._templateType, name: a._groupName, items: [] }; order.push(a._groupId); }
      byId[a._groupId].items.push({ a: a, i: i });
    } else {
      orphans.push({ a: a, i: i });
    }
  });
  return { groups: order.map(function(id) { return byId[id]; }), orphans: orphans };
}

function devName(id) {
  var d = State.devices.find(function(x) { return x.id === id; });
  return d ? d.name : '';
}

function groupSummary(g) {
  var icons = { motion_lights:'🏃', smart_dim:'🌙', door_lights:'🚪', schedule:'⏰', switch:'🔘' };
  var icon  = icons[g.type] || '⚙️';
  var trigger = g.items[0] && g.items[0].a.trigger;
  var sensor  = trigger && trigger.deviceId ? devName(trigger.deviceId) : '';

  if (g.type === 'switch') {
    var firstA = g.items[0] && g.items[0].a;
    var parts = ['🔘'];
    if (sensor) parts.push(sensor);
    if (firstA && firstA._useHomeyFlows) {
      var n = (firstA._switchMappings || []).filter(function(m){ return m.groupId; }).length;
      if (n) parts.push(n + ' button' + (n !== 1 ? 's' : '') + ' (via Flows)');
    } else {
      var mappedNames = [];
      g.items.forEach(function(it) {
        var runAct = (it.a.actions||[]).find(function(a){ return a.type === 'run_group'; });
        if (!runAct) return;
        var targetAuto = State.automations.find(function(a){ return a._groupId === runAct.groupId; });
        var n = targetAuto ? (targetAuto._groupName || targetAuto.name) : null;
        if (n && mappedNames.indexOf(n) === -1) mappedNames.push(n);
      });
      if (mappedNames.length) parts.push('→ ' + mappedNames.join(', '));
    }
    return parts.join(' · ');
  }

  // Count unique lights
  var lights  = new Set();
  g.items.forEach(function(it) {
    (it.a.actions || []).forEach(function(ac) { if (ac.type === 'turn_on') lights.add(ac.deviceId); });
  });
  // Time for schedule
  var dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var schedDays = (g.type === 'schedule' && trigger && trigger.days && trigger.days.length)
    ? trigger.days.slice().sort(function(a,b){return a-b;}).map(function(d){return dayNames[d];}).join(',')
    : '';
  var time = (g.type === 'schedule' && trigger) ? ('at ' + trigger.time + (schedDays ? ' · ' + schedDays : '')) : '';
  var parts = [icon];
  if (sensor) parts.push(sensor);
  if (time)   parts.push(time);
  if (lights.size) parts.push(lights.size + ' light' + (lights.size !== 1 ? 's' : ''));
  return parts.join(' · ');
}

// ── Hold countdown ─────────────────────────────────────────────────────────────
var Countdown = {
  tick: function() {
    var now = Date.now();
    var hs  = State.holdStatus || {};
    var ov  = State.overrides  || {};

    document.querySelectorAll('[data-cd-gid]').forEach(function(el) {
      var gid   = el.getAttribute('data-cd-gid');
      var endsAt = hs[gid];
      if (!endsAt || endsAt <= now) { el.style.display = 'none'; return; }
      var secs  = Math.round((endsAt - now) / 1000);
      var mins  = Math.floor(secs / 60);
      var s     = secs % 60;
      el.textContent = '⏱ off in ' + (mins > 0 ? mins + ':' + String(s).padStart(2,'0') : s + 's');
      el.style.display = '';
    });

    document.querySelectorAll('[data-ov-gid]').forEach(function(el) {
      var gid      = el.getAttribute('data-ov-gid');
      var expiresAt = ov[gid];
      var btn = document.querySelector('[data-ov-btn="' + gid + '"]');
      if (!expiresAt || expiresAt <= now) {
        el.style.display = 'none';
        if (btn) btn.classList.remove('active');
        return;
      }
      var rem  = expiresAt - now;
      var h    = Math.floor(rem / 3600000);
      var m    = Math.floor((rem % 3600000) / 60000);
      var disp = h > 0 ? h + 'h ' + m + 'm' : (m > 0 ? m + 'm' : 'ending soon');
      el.textContent = '⏸ paused ' + disp;
      el.style.display = '';
      if (btn) btn.classList.add('active');
    });
  }
};

