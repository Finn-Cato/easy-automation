    if (orphans.length) {
      if (groups.length) html += '<div class="sec-hdr" style="margin-top:18px">Custom automations</div>';
      html += '<div class="auto-list-wrap">';
      orphans.forEach(function(item) {
        var a = item.a, i = item.i;
        html += '<div class="card">' +
          '<label class="tog"><input type="checkbox"' + (a.enabled ? ' checked' : '') +
            ' onchange="AutoList.toggle(' + i + ',this.checked)"/><span class="tog-track"></span></label>' +
