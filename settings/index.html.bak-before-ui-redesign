  _singleSummary: function(a) {
    var t = a.trigger || {};
    var labels = { motion_start:'Motion on', motion_stop:'Motion off', door_open:'Door opens', door_close:'Door closes' };
    var s = t.type === 'time' ? ('Every day at ' + (t.time||'?')) : (labels[t.type] || t.type || '');
    if (t.deviceId) s += ' · ' + (devName(t.deviceId) || 'Unknown');
    var n = (a.actions||[]).length;
    return s + ' → ' + n + ' action' + (n !== 1 ? 's' : '');
  },

  toggleGroup: function(gi, val) {
    var g = AutoList._computed.groups[gi];
    g.items.forEach(function(it) { State.automations[it.i].enabled = val; });
    AutoList.persist('Saved');
  },

  toggle: function(i, val) {
    State.automations[i].enabled = val;
    AutoList.persist('Saved');
  },

  delGroup: async function(gi) {
    var g = AutoList._computed.groups[gi];
    var yes = await window._hConfirm('Delete "' + (g.name || 'this automation') + '"?');
    if (!yes) return;
    var indices = g.items.map(function(it) { return it.i; }).sort(function(a,b){return b-a;});
    indices.forEach(function(i) { State.automations.splice(i, 1); });
    await AutoList.persist('Deleted');
  },

  editGroup: function(gi) {
    var g = AutoList._computed.groups[gi];
    if (g.type && g.type !== 'custom') {
      TModal.openEdit(g);
    } else if (g.items.length === 1) {
      CustomEditor.open(g.items[0].i);
    }
  },

  del: async function(i) {
    var yes = await window._hConfirm('Delete "' + (State.automations[i].name||'this automation') + '"?');
    if (yes) { State.automations.splice(i, 1); await AutoList.persist('Deleted'); }
  },

  persist: async function(msg) {
    setStatus('Saving…');
    try {
      await API.saveAutomations(State.automations);
      AutoList.render();
      setStatus(msg || 'Saved', 3000);
    } catch(e) { setStatus('Save failed: ' + e.message, 5000); }
  },

  addAll: async function(newAutomations) {
    newAutomations.forEach(function(a) { State.automations.push(a); });
    await AutoList.persist('Added');
  }
};

