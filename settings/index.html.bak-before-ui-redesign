        if (el('t-fadeout'))  { el('t-fadeout').value = fadeOut0D; if(el('t-fadeout-val')) el('t-fadeout-val').textContent = fadeOut0D===0?'instant':fadeOut0D+'s'; }
        if (el('t-fadeout-wrap')) el('t-fadeout-wrap').style.display = hasOff ? '' : 'none';
        if (el('t-name'))     el('t-name').value = g.name || '';
      }, 0);

    } else if (g.type === 'schedule') {
      var a0      = (g.items[0]||{}).a || {};
      var lights  = [];
      var action  = 'on';
      var bright  = 50;
      (a0.actions||[]).forEach(function(ac){
        if (ac.type==='turn_on')  { lights.push(ac.deviceId); action='on'; }
        if (ac.type==='turn_off') { lights.push(ac.deviceId); action='off'; }
        if (ac.type==='set_dim')  { bright=Math.round(ac.value*100); action='dim'; }
      });
      Picker.render('dp-lights', lights, 'onoff');
      setTimeout(function(){
        if (a0.trigger && el('t-time')) tpSet('t-time', a0.trigger.time || '07:00');
        if (el('t-sched-action')) { el('t-sched-action').value = action; TModal._schedActionChanged(); }
        if (el('t-bright'))  { el('t-bright').value = bright; if(el('t-bval')) el('t-bval').textContent = bright+'%'; }
        if (el('t-name'))    el('t-name').value = g.name || '';
        if (el('t-days') && a0.trigger) {
          var savedDays = a0.trigger.days;
          el('t-days').querySelectorAll('.day-chk').forEach(function(cb) {
            cb.checked = !savedDays || savedDays.length === 0 || savedDays.indexOf(parseInt(cb.value)) !== -1;
          });
        }
      }, 0);

    } else if (g.type === 'switch') {
      var firstItem = g.items[0] && g.items[0].a;
      var swDev = firstItem && firstItem.trigger && firstItem.trigger.deviceId;
      var isFlowMode = firstItem && firstItem._useHomeyFlows;
      var savedMappings = isFlowMode ? (firstItem._switchMappings || []) : null;
      setTimeout(function() {
        if (swDev && el('t-switch')) {
          el('t-switch').value = swDev;
          // _switchDeviceChanged is async — after it resolves, set values
          Promise.resolve(TModal._switchDeviceChanged()).then(function() {
            if (isFlowMode && savedMappings) {
              // Re-populate flow rows by triggerId match
              savedMappings.forEach(function(m) {
                var j = 0;
                while (el('t-sw-map-' + j)) {
                  var sel = el('t-sw-map-' + j);
                  if (sel.getAttribute('data-trigger-id') === m.triggerId) {
                    sel.value = m.groupId;
                    break;
                  }
                  j++;
                }
              });
            } else {
              // Standard cap mode — match by trigger type/cap
              g.items.forEach(function(it) {
                var trig   = it.a.trigger;
                var runAct = (it.a.actions || []).find(function(a){ return a.type === 'run_group'; });
                if (!trig || !runAct) return;
                var savedKey = trig.type === 'button_key' ? trig.type + ':' + trig.capability : trig.type;
                var j = 0;
                while (el('t-sw-map-' + j)) {
                  var sel = el('t-sw-map-' + j);
                  var rowKey = sel.getAttribute('data-trigger-type') === 'button_key'
                    ? sel.getAttribute('data-trigger-type') + ':' + sel.getAttribute('data-cap')
                    : sel.getAttribute('data-trigger-type');
                  if (rowKey === savedKey) { sel.value = runAct.groupId; break; }
                  j++;
                }
              });
            }
          });
        }
        if (el('t-name')) el('t-name').value = g.name || '';
      }, 0);
    }
  },

