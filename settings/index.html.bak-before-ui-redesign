  _setLightDim: function(deviceId, mode, pct) {
    if (!TModal._lightDims[deviceId]) TModal._lightDims[deviceId] = {};
    TModal._lightDims[deviceId][mode] = pct / 100;
    TModal._updateGlobalFromLights(mode);
  },

  _updateGlobalFromLights: function(mode) {
    var lights = Picker.getSelected('dp-lights');
    if (!lights.length) return;
    var sum = 0, count = 0;
    lights.forEach(function(id) {
      var v = TModal._lightDims[id] && TModal._lightDims[id][mode] != null ? Math.round(TModal._lightDims[id][mode] * 100) : null;
      if (v != null) { sum += v; count++; }
    });
    if (!count) return;
    var avg = Math.round(sum / count);
    var slId = mode === 'day' ? 't-day-bright' : mode === 'night' ? 't-night-bright' : 't-bright';
    var vlId = mode === 'day' ? 't-day-bval'   : mode === 'night' ? 't-night-bval'   : 't-bval';
    if (el(slId)) { el(slId).value = avg; TModal._prevGlobal[mode] = avg; }
    if (el(vlId)) el(vlId).textContent = avg + '%';
  },

  _globalChanged: function(mode, newPct) {
    var prev  = TModal._prevGlobal[mode] != null ? TModal._prevGlobal[mode] : newPct;
    var delta = newPct - prev;
    TModal._prevGlobal[mode] = newPct;
    if (delta === 0) return;
    var lights = Picker.getSelected('dp-lights');
    lights.forEach(function(id) {
      if (!TModal._lightDims[id]) TModal._lightDims[id] = {};
      var cur = TModal._lightDims[id][mode] != null ? Math.round(TModal._lightDims[id][mode] * 100) : prev;
      var nv  = Math.max(1, Math.min(100, cur + delta));
      TModal._lightDims[id][mode] = nv / 100;
    });
    // Refresh lights tab if open
    if (el('tmpl-lights-tab') && el('tmpl-lights-tab').style.display !== 'none') TModal._renderLightsTab();
  },

