  _runGroupTest: async function(groupId) {
    var resEl = el('tmpl-test-result');
    if (!resEl) return;
    resEl.innerHTML = '<p style="color:#8e8e93;font-size:13px">Running…</p>';
    var ts = Date.now();
    try {
      await window._hSet('_testRequest', JSON.stringify({ actions: [{ type: 'run_group', groupId: groupId }], name: 'Switch test', ts: ts }));
      await new Promise(function(r){ setTimeout(r, 2500); });
      var raw = await window._hGet('_testResult');
      var res = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : null;
      if (!res || res.reqTs !== ts) {
        resEl.innerHTML = '<p style="color:#ff3b30;font-size:13px">⚠️ No response — check Logs tab.</p>';
        return;
      }
      resEl.innerHTML = res.ok
        ? '<p style="color:#34c759;font-size:13px">✓ Automation ran successfully.</p>'
        : '<p style="color:#ff3b30;font-size:13px">✗ ' + esc(res.error || 'Unknown error') + '</p>';
    } catch(e) {
      resEl.innerHTML = '<p style="color:#ff3b30;font-size:13px">✗ ' + esc(e.message) + '</p>';
    }
  },

  _buildTestActions: function(phase) {
    var lights = Picker.getSelected('dp-lights');
    if (!lights.length) return [];
    var actions = [];
    if (phase === 'off') {
      lights.forEach(function(id) { actions.push({ type: 'turn_off', deviceId: id }); });
      return actions;
    }
    // ON / day / night / schedule
    lights.forEach(function(id) { actions.push({ type: 'turn_on', deviceId: id }); });
    var mode = (phase === 'day') ? 'day' : (phase === 'night') ? 'night' : 'on';
    var defBright = 1;
    if (mode === 'day')   defBright = el('t-day-bright')   ? parseInt(el('t-day-bright').value)   / 100 : 1;
    else if (mode === 'night') defBright = el('t-night-bright') ? parseInt(el('t-night-bright').value) / 100 : 0.2;
    else                  defBright = el('t-bright')       ? parseInt(el('t-bright').value)       / 100 : 1;
    lights.forEach(function(id) {
      var dimVal = (TModal._lightDims[id] && TModal._lightDims[id][mode] != null) ? TModal._lightDims[id][mode] : defBright;
      if (dimVal < 1) actions.push({ type: 'set_dim', deviceId: id, value: dimVal });
    });
    return actions;
  },

  _runModalTest: async function(phase) {
    var resEl = el('tmpl-test-result');
    if (!resEl) { TModal._renderTestTab(); resEl = el('tmpl-test-result'); }
    var actions = TModal._buildTestActions(phase);
    if (!actions.length) { resEl.innerHTML = '<p style="color:#ff3b30;font-size:13px">No lights selected.</p>'; return; }
    resEl.innerHTML = '<p style="color:#8e8e93;font-size:13px">Running…</p>';
    var labels = { on:'💡 ON', day:'☀️ Day', night:'🌙 Night', off:'⚫ Off' };
    var label  = labels[phase] || phase;
    var ts = Date.now();
    try {
      await window._hSet('_testRequest', JSON.stringify({ actions: actions, name: label, ts: ts }));
      await new Promise(function(r) { setTimeout(r, 2500); });
      var raw = await window._hGet('_testResult');
      var res = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : null;
      if (!res || res.reqTs !== ts) {
        resEl.innerHTML = '<p style="color:#ff3b30;font-size:13px">⚠️ No response — check Logs tab.</p>';
        return;
      }
      // Build per-light state from actions
      var ls = {};
      actions.forEach(function(a, idx) {
        if (!a.deviceId) return;
        if (!ls[a.deviceId]) ls[a.deviceId] = { on: null, dim: null, err: false };
        if (a.type === 'turn_on')  ls[a.deviceId].on  = true;
        if (a.type === 'turn_off' || a.type === 'fade_off') ls[a.deviceId].on = false;
        if (a.type === 'set_dim'  || a.type === 'fade_to')  ls[a.deviceId].dim = a.value;
        if (res.results[idx] && !res.results[idx].ok) ls[a.deviceId].err = true;
      });
      var allOk = res.results.every(function(r) { return r.ok; });
      var bulbs = Object.keys(ls).map(function(id) {
        var s = ls[id], nm = devName(id) || id.slice(-6);
        var isOn = s.on !== false, pct = s.dim != null ? Math.round(s.dim * 100) : null;
        var icon  = s.err ? '❌' : (isOn ? '💡' : '🔌');
        var state = s.err ? 'Error' : (isOn ? (pct != null ? pct + '%' : 'ON') : 'OFF');
        var col   = s.err ? '#ff3b30' : (isOn ? '#ff9500' : '#8e8e93');
        return '<div class="light-tile"><span class="light-tile-icon">' + icon + '</span>' +
          '<div class="light-tile-name">' + esc(nm) + '</div>' +
          '<div class="light-tile-state" style="color:' + col + '">' + state + '</div></div>';
      }).join('');
      resEl.innerHTML =
        '<div style="display:flex;align-items:center;gap:6px;margin-bottom:10px">' +
          '<span>' + (allOk ? '✅' : '⚠️') + '</span>' +
          '<span style="font-size:13px;font-weight:700">' + esc(label) + '</span>' +
        '</div>' +
        (bulbs ? '<div class="light-grid" style="margin:0 -0px">' + bulbs + '</div>' : '');
    } catch(e) {
      resEl.innerHTML = '<p style="color:#ff3b30;font-size:13px">Error: ' + esc(e.message) + '</p>';
    }
  },

