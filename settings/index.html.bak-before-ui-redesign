// ── Lights tab (removed from nav — kept only for modal inner tab) ───────────────
var LightsTab = {
  _saveTimer: null,

  render: function() {
    var computed = computeGroups();
    var html = '';

    computed.groups.forEach(function(g) {
      // Collect unique light deviceIds that are turned ON in this group
      var lightIds = [], seen = {};
      g.items.forEach(function(it) {
        (it.a.actions || []).forEach(function(ac) {
          if (ac.type === 'turn_on' && ac.deviceId && !seen[ac.deviceId]) {
            seen[ac.deviceId] = true;
            lightIds.push(ac.deviceId);
          }
        });
      });
      if (!lightIds.length) return;

      var icons = { motion_lights:'🏃', smart_dim:'🌙', door_lights:'🚪', schedule:'⏰', switch:'🔘' };
      html += '<div class="sec-hdr">' + esc((icons[g.type] || '⚙️') + '  ' + (g.name || 'Automation')) + '</div>';
      html += '<div class="auto-list-wrap">';

      lightIds.forEach(function(deviceId) {
        var dname   = devName(deviceId) || deviceId;
        var safeGid = g.id.replace(/[^a-zA-Z0-9]/g, '_');
        var safeDid = deviceId.replace(/[^a-zA-Z0-9]/g, '_');
        var prefix  = 'lt_' + safeGid + '_' + safeDid;

        html += '<div class="lt-card">';
        html += '<div class="lt-name">💡 ' + esc(dname) + '</div>';

        if (g.type === 'smart_dim') {
          // Two sliders: Day and Night
          var modes = [
            { key: 'day',   label: '☀️ Day',   part: ' — Day'   },
            { key: 'night', label: '🌙 Night', part: ' — Night' }
          ];
          modes.forEach(function(m) {
            var modeItem = g.items.find(function(it) { return it.a.name && it.a.name.indexOf(m.part) !== -1; });
            var dimAc = modeItem && (modeItem.a.actions || []).find(function(ac) {
              return (ac.type === 'set_dim' || ac.type === 'fade_to') && ac.deviceId === deviceId;
            });
            var pct = dimAc ? Math.round((dimAc.value || 1) * 100) : 100;
            var sid = prefix + '_' + m.key;
            var vid = sid + '_v';
            html += '<div class="lt-row">' +
              '<span class="lt-label">' + m.label + '</span>' +
              '<div class="slider-row" style="flex:1;margin-top:0">' +
                '<input type="range" id="' + sid + '" min="1" max="100" value="' + pct + '"' +
                  ' oninput="document.getElementById(\'' + vid + '\').textContent=this.value+\'%\';' +
                  'LightsTab.updateDim(' + JSON.stringify(g.id) + ',' + JSON.stringify(deviceId) + ',' + JSON.stringify(m.key) + ',parseInt(this.value))">' +
                '<span class="slider-val" id="' + vid + '">' + pct + '%</span>' +
              '</div>' +
            '</div>';
          });
        } else {
          // Single brightness slider (motion, door, switch)
          var dimAc = null;
          g.items.forEach(function(it) {
            if (!dimAc) dimAc = (it.a.actions || []).find(function(ac) {
              return (ac.type === 'set_dim' || ac.type === 'fade_to') && ac.deviceId === deviceId;
            });
          });
          var pct = dimAc ? Math.round((dimAc.value || 1) * 100) : 100;
          var sid = prefix + '_on';
          var vid = sid + '_v';
          html += '<div class="lt-row">' +
            '<span class="lt-label">💡 ON</span>' +
            '<div class="slider-row" style="flex:1;margin-top:0">' +
              '<input type="range" id="' + sid + '" min="1" max="100" value="' + pct + '"' +
                ' oninput="document.getElementById(\'' + vid + '\').textContent=this.value+\'%\';' +
                'LightsTab.updateDim(' + JSON.stringify(g.id) + ',' + JSON.stringify(deviceId) + ',\'on\',parseInt(this.value))">' +
              '<span class="slider-val" id="' + vid + '">' + pct + '%</span>' +
            '</div>' +
          '</div>';
        }

        html += '</div>'; // lt-card
      });

      html += '</div>'; // auto-list-wrap
    });

    if (!html) {
      html = '<div class="empty"><div class="icon">💡</div><p>No lights configured yet.<br>Add a Motion, Smart Dim, Door, or Switch automation first.</p></div>';
    }
    el('lights-list').innerHTML = html;
  },

  updateDim: function(groupId, deviceId, mode, pct) {
    var val = pct / 100;
    State.automations.forEach(function(a) {
      if (a._groupId !== groupId) return;
      // For smart_dim, only update the Day or Night part
      if (mode === 'day'   && !(a.name && a.name.indexOf(' — Day')   !== -1)) return;
      if (mode === 'night' && !(a.name && a.name.indexOf(' — Night') !== -1)) return;
      // Skip automations that don't touch this device at all
      var hasDev = (a.actions || []).some(function(ac) { return ac.deviceId === deviceId; });
      if (!hasDev) return;
      // Update existing dim action
      var dimAc = (a.actions || []).find(function(ac) {
        return (ac.type === 'set_dim' || ac.type === 'fade_to') && ac.deviceId === deviceId;
      });
      if (dimAc) {
        dimAc.value = val;
      } else if (val < 1) {
        // Insert set_dim right after the turn_on for this device
        var toIdx = (a.actions || []).findIndex(function(ac) {
          return ac.type === 'turn_on' && ac.deviceId === deviceId;
        });
        if (toIdx >= 0) a.actions.splice(toIdx + 1, 0, { type: 'set_dim', deviceId: deviceId, value: val });
      }
    });
    clearTimeout(LightsTab._saveTimer);
    LightsTab._saveTimer = setTimeout(function() {
      AutoList.persist('Dim saved').catch(function(){});
    }, 800);
  }
};

// ── Test tab ───────────────────────────────────────────────────────────────────
var TestTab = {

  render: function() {
    // Automation list with Run buttons
    var list = el('test-auto-list');
    var computed = computeGroups();
    var groups  = computed.groups;
    var orphans = computed.orphans;

    if (!groups.length && !orphans.length) {
      list.innerHTML = '<div class="empty"><div class="icon">⚡</div><p>No automations yet.</p></div>';
    } else {
      var html = '<div class="auto-list-wrap">';
      groups.forEach(function(g, gi) {
        html += '<div class="card">' +
          '<div class="card-body" style="flex:1">' +
            '<div class="card-name">' + esc(g.name || 'Automation') + '</div>' +
            '<div class="card-sub">' + esc(groupSummary(g)) + '</div>' +
          '</div>' +
          '<button class="btn btn-blue" style="padding:6px 14px;font-size:13px" onclick="TestTab.runGroup(' + gi + ')">▶ Run</button>' +
        '</div>';
      });
      orphans.forEach(function(item) {
        html += '<div class="card">' +
          '<div class="card-body" style="flex:1">' +
            '<div class="card-name">' + esc(item.a.name || 'Unnamed') + '</div>' +
            '<div class="card-sub">' + esc(AutoList._singleSummary(item.a)) + '</div>' +
          '</div>' +
          '<button class="btn btn-blue" style="padding:6px 14px;font-size:13px" onclick="TestTab.runSingle(' + item.i + ')">▶ Run</button>' +
        '</div>';
      });
      html += '</div>';
      list.innerHTML = html;
    }

    // Device selector — all controllable devices
    var sel = el('test-dev-sel');
    var saved = sel.value;
    var controllable = State.devices.filter(function(d) {
      return d.capabilities && (d.capabilities.indexOf('onoff') !== -1 || d.capabilities.indexOf('dim') !== -1);
    });
    var zones = {}, noZone = [];
    controllable.forEach(function(d) {
      if (d.zone) { if (!zones[d.zone]) zones[d.zone] = []; zones[d.zone].push(d); }
      else noZone.push(d);
    });
    var opts = '<option value="">— Select device —</option>';
    Object.keys(zones).sort().forEach(function(z) {
      opts += '<optgroup label="' + esc(z) + '">';
      zones[z].forEach(function(d) { opts += '<option value="' + esc(d.id) + '">' + esc(d.name) + '</option>'; });
      opts += '</optgroup>';
    });
    noZone.forEach(function(d) { opts += '<option value="' + esc(d.id) + '">' + esc(d.name) + '</option>'; });
    sel.innerHTML = opts;
    if (saved) sel.value = saved;
  },

  runGroup: async function(gi) {
    var computed = computeGroups();
    var g = computed.groups[gi];
    var allActions = [];
    g.items.forEach(function(it) {
      (it.a.actions || []).forEach(function(ac) { allActions.push(ac); });
    });
    await TestTab._run(allActions, g.name || 'Automation');
  },

  runSingle: async function(i) {
    var a = State.automations[i];
    await TestTab._run(a.actions || [], a.name || 'Automation');
  },

  runDevice: async function() {
    var devId = el('test-dev-sel').value;
    if (!devId) { window._hAlert('Please select a device first.'); return; }
    var act   = el('test-act-sel').value;
    var actions = [];
    if (act === 'turn_on')  { actions = [{ type: 'turn_on',  deviceId: devId }]; }
    if (act === 'turn_off') { actions = [{ type: 'turn_off', deviceId: devId }]; }
    if (act === 'dim_10')   { actions = [{ type: 'turn_on', deviceId: devId }, { type: 'set_dim', deviceId: devId, value: 0.1 }]; }
    if (act === 'dim_30')   { actions = [{ type: 'turn_on', deviceId: devId }, { type: 'set_dim', deviceId: devId, value: 0.3 }]; }
    if (act === 'dim_50')   { actions = [{ type: 'turn_on', deviceId: devId }, { type: 'set_dim', deviceId: devId, value: 0.5 }]; }
    if (act === 'dim_100')  { actions = [{ type: 'turn_on', deviceId: devId }, { type: 'set_dim', deviceId: devId, value: 1.0 }]; }
    var dname = devName(devId) || devId;
    await TestTab._run(actions, 'Device: ' + dname);
  },

  _run: async function(actions, label) {
    var resultEl = el('test-result');
    resultEl.innerHTML = '<div class="loader">Running…</div>';
    var ts = Date.now();
    try {
      await window._hSet('_testRequest', JSON.stringify({ actions: actions, name: label, ts: ts }));
      // Wait for backend to process
      await new Promise(function(r) { setTimeout(r, 2500); });
      var raw = await window._hGet('_testResult');
      var res = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : null;
      if (!res || res.reqTs !== ts) {
        resultEl.innerHTML = '<p style="color:#ff3b30;font-size:14px">⚠️ No response from app. Check the Logs tab for errors.</p>';
        return;
      }
      // Build per-light final state from the actions list
      var lightStates = {};
      actions.forEach(function(a, idx) {
        if (!a.deviceId) return;
        if (!lightStates[a.deviceId]) lightStates[a.deviceId] = { on: null, dim: null, err: false };
        if (a.type === 'turn_on')                              lightStates[a.deviceId].on  = true;
        if (a.type === 'turn_off' || a.type === 'fade_off')    lightStates[a.deviceId].on  = false;
        if (a.type === 'set_dim'  || a.type === 'fade_to')   { lightStates[a.deviceId].dim = a.value != null ? a.value : null; }
        if (res.results[idx] && !res.results[idx].ok)          lightStates[a.deviceId].err = true;
      });

      var lightIds = Object.keys(lightStates);
      var bulbsHtml = '';
      if (lightIds.length) {
        bulbsHtml = '<div class="light-grid">';
        lightIds.forEach(function(id) {
          var s   = lightStates[id];
          var nm  = devName(id) || id.slice(-6);
          var isOn = s.on !== false;
          var pct  = s.dim != null ? Math.round(s.dim * 100) : null;
          var icon  = s.err ? '❌' : (isOn ? '💡' : '🔌');
          var state = s.err ? 'Error' : (isOn ? (pct != null ? pct + '%' : 'ON') : 'OFF');
          var col   = s.err ? '#ff3b30' : (isOn ? '#ff9500' : '#8e8e93');
          bulbsHtml += '<div class="light-tile">' +
            '<span class="light-tile-icon">' + icon + '</span>' +
            '<div class="light-tile-name">' + esc(nm) + '</div>' +
            '<div class="light-tile-state" style="color:' + col + '">' + esc(state) + '</div>' +
          '</div>';
        });
        bulbsHtml += '</div>';
      }

      var allOk = res.results.every(function(r) { return r.ok; });
      var rows = res.results.map(function(r, idx) {
        var a = actions[idx] || {};
        return '<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f2f2f7">' +
          '<span style="font-size:14px">' + (r.ok ? '✅' : '❌') + '</span>' +
          '<div style="flex:1;font-size:12px">' +
            '<span style="font-weight:600">' + esc(r.action || a.type || '') + '</span>' +
            (a.deviceId ? ' → <span style="color:#8e8e93">' + esc(devName(a.deviceId) || a.deviceId) + '</span>' : '') +
            (r.error ? '<div style="color:#ff3b30;font-size:11px">' + esc(r.error) + '</div>' : '') +
          '</div>' +
        '</div>';
      });
      resultEl.innerHTML =
        '<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">' +
          '<span style="font-size:18px">' + (allOk ? '✅' : '⚠️') + '</span>' +
          '<div style="font-size:14px;font-weight:700">' + esc(label) + '</div>' +
        '</div>' +
        bulbsHtml +
        (rows.length ? '<div>' + rows.join('') + '</div>' : '<p style="color:#8e8e93;font-size:14px">No actions were run.</p>');
    } catch(e) {
      resultEl.innerHTML = '<p style="color:#ff3b30;font-size:14px">Error: ' + esc(e.message) + '</p>';
    }
  }
};

// ── Devices tab ────────────────────────────────────────────────────────────────
var DevTab = {
  render: function() {
    var list = el('device-list');
    if (!State.devices.length) {
      list.innerHTML = '<div class="empty"><div class="icon">📡</div><p>No devices cached yet.<br>Press <strong>Refresh</strong> to load them from Homey.</p></div>';
      return;
    }
    // Group by zone
    var zones = {}, noZone = [];
    State.devices.forEach(function(d) {
      if (d.zone) { if (!zones[d.zone]) zones[d.zone] = []; zones[d.zone].push(d); }
      else noZone.push(d);
    });
    var html = '';
    var renderGroup = function(devs) {
      return devs.map(function(d) {
        return '<div class="device-card">' +
          '<div class="device-card-info">' +
            '<div class="device-card-name">' + esc(d.name) + '</div>' +
            '<div class="device-card-sub">' + esc(d.class||'') + (d.zone ? ' · ' + esc(d.zone) : '') + '</div>' +
          '</div>' +
          '<span class="badge">' + (d.available ? 'Online' : 'Offline') + '</span>' +
        '</div>';
      }).join('');
    };
    Object.keys(zones).sort().forEach(function(z) {
      html += '<div class="sec-hdr">' + esc(z) + '</div>' + renderGroup(zones[z]);
    });
    if (noZone.length) html += '<div class="sec-hdr">Other</div>' + renderGroup(noZone);
    list.innerHTML = html;
  },

  refresh: async function() {
    var btn = el('btn-refresh-dev');
    btn.textContent = 'Refreshing…'; btn.disabled = true;
    try {
      await window._hSet('_refreshDevices', Date.now());
      await new Promise(function(r) { setTimeout(r, 2500); });
      var raw = await window._hGet('_deviceCache');
      State.devices = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : [];
      DevTab.render();
    } catch(e) {
      el('device-list').innerHTML = '<div class="loader" style="color:#ff3b30">Error: ' + e.message + '</div>';
    } finally { btn.textContent = 'Refresh'; btn.disabled = false; }
  }
};

// ── 24h time picker helpers ────────────────────────────────────────────────────
function mkTimePicker(id, defaultVal) {
  var parts = (defaultVal || '00:00').split(':');
  var h = String(Math.max(0, Math.min(23, parseInt(parts[0]) || 0))).padStart(2,'0');
  var m = String(Math.max(0, Math.min(59, parseInt(parts[1]) || 0))).padStart(2,'0');
  function col(part, val) {
    var up   = 'ontouchstart="event.preventDefault();tpStep(\'' + id + '\',\'' + part + '\',1)"  onclick="tpStep(\'' + id + '\',\'' + part + '\',1)"';
    var down = 'ontouchstart="event.preventDefault();tpStep(\'' + id + '\',\'' + part + '\',-1)" onclick="tpStep(\'' + id + '\',\'' + part + '\',-1)"';
    return '<div class="tp-col">' +
      '<button class="tp-btn" ' + up   + '>▲</button>' +
      '<div class="tp-val" id="' + id + '-' + part + '">' + val + '</div>' +
      '<button class="tp-btn" ' + down + '>▼</button>' +
      '</div>';
  }
  return '<div class="tp-wrap">' +
    col('h', h) +
    '<span class="tp-sep">:</span>' +
    col('m', m) +
    '<input type="hidden" id="' + id + '" value="' + h + ':' + m + '">' +
    '</div>';
}
function tpStep(id, part, dir) {
  var hEl = el(id+'-h'), mEl = el(id+'-m');
  var h = parseInt(hEl.textContent) || 0;
  var m = parseInt(mEl.textContent) || 0;
  if (part === 'h') { h = (h + dir + 24) % 24; hEl.textContent = String(h).padStart(2,'0'); }
  else              { m = (m + dir + 60) % 60; mEl.textContent = String(m).padStart(2,'0'); }
  el(id).value = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
}
function tpSet(id, val) {
  var parts = (val || '00:00').split(':');
  var h = String(Math.max(0, Math.min(23, parseInt(parts[0]) || 0))).padStart(2,'0');
  var m = String(Math.max(0, Math.min(59, parseInt(parts[1]) || 0))).padStart(2,'0');
  if (el(id+'-h')) el(id+'-h').textContent = h;
  if (el(id+'-m')) el(id+'-m').textContent = m;
  if (el(id))      el(id).value = h + ':' + m;
}

// ── Logs tab ───────────────────────────────────────────────────────────────────
var LogTab = {
  load: async function() {
    el('log-list').innerHTML = '<div class="loader">Loading…</div>';
    try {
      var raw  = await window._hGet('_appLog');
      var logs = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : [];
      if (!logs.length) { el('log-list').innerHTML = '<div class="loader">No log entries yet.</div>'; return; }
      LogTab._logs = logs;
      el('log-list').innerHTML = logs.map(function(l) {
        var d  = new Date(l.ts);
        var ts = d.toLocaleDateString([],{month:'short',day:'numeric'}) + ' ' + d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',hour12:false});
        return '<div class="log-row">' +
          '<span class="log-ts">' + ts + '</span>' +
          '<span class="log-lv ' + esc(l.level) + '">' + esc(l.level) + '</span>' +
          '<span class="log-msg">' + esc(l.message) + '</span>' +
        '</div>';
      }).join('');
    } catch(e) { el('log-list').innerHTML = '<div class="loader">Error: ' + e.message + '</div>'; }
  },
  copy: async function() {
    if (!LogTab._logs) await LogTab.load();
    var text = LogTab._logs.map(function(l) {
      return l.ts + ' [' + l.level + '] ' + l.message;
    }).join('\n');
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    alert('Log copied to clipboard');
  }
};
</script>
