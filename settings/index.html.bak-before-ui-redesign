  _mkId: function() { return 'a' + Date.now() + Math.floor(Math.random()*1000); },

  _saveMotion: function() {
    var sensor  = el('t-sensor').value; if (!sensor) throw new Error('Please select a motion sensor');
    var lights  = Picker.getSelected('dp-lights'); if (!lights.length) throw new Error('Please select at least one light');
    var bright  = parseInt(el('t-bright').value) / 100;
    var fadeIn  = parseInt(el('t-fadein') ? el('t-fadein').value : 0) || 0;
    var turnOff = el('t-turnoff').checked;
    var hold    = el('t-hold') ? parseInt(el('t-hold').value) : 0;
    var fadeOut = parseInt(el('t-fadeout') ? el('t-fadeout').value : 0) || 0;
    var name    = el('t-name').value.trim() || 'Motion Lights';
    var gid = TModal._mkId();
    var list = [];

    // Turn on all lights first, then apply per-light dim (fallback to global bright)
    var onActs = lights.map(function(id) { return { type: 'turn_on', deviceId: id }; });
    lights.forEach(function(id) {
      var dimVal = (TModal._lightDims[id] && TModal._lightDims[id].on != null) ? TModal._lightDims[id].on : bright;
      if (fadeIn > 0) {
        onActs.push({ type: 'fade_to', deviceId: id, value: dimVal, duration: fadeIn });
      } else if (dimVal < 1) {
        onActs.push({ type: 'set_dim', deviceId: id, value: dimVal });
      }
    });
    list.push({ id: TModal._mkId(), name: name + ' — ON', enabled: true,
      _groupId: gid, _groupName: name, _templateType: 'motion_lights',
      trigger: { type: 'motion_start', deviceId: sensor }, conditions: [], actions: onActs });

    if (turnOff) {
      var offActs = lights.map(function(id) {
        return fadeOut > 0 ? { type: 'fade_off', deviceId: id, duration: fadeOut } : { type: 'turn_off', deviceId: id };
      });
      list.push({ id: TModal._mkId(), name: name + ' — OFF', enabled: true,
        _groupId: gid, _groupName: name, _templateType: 'motion_lights',
        _holdMinutes: hold,
        trigger: { type: 'motion_stop', deviceId: sensor }, conditions: [], actions: offActs });
    }
    return list;
  },

  _saveSmartDim: function() {
    var sensor     = el('t-sensor').value;     if (!sensor) throw new Error('Please select a motion sensor');
    var lights     = Picker.getSelected('dp-lights'); if (!lights.length) throw new Error('Please select at least one light');
    var dayFrom    = el('t-day-from').value   || '07:00';
    var nightFrom  = el('t-night-from').value || '22:00';
    var dayBright  = parseInt(el('t-day-bright').value)   / 100;
    var nightBright= parseInt(el('t-night-bright').value) / 100;
    var turnOff    = el('t-turnoff').checked;
    var hold       = el('t-hold') ? parseInt(el('t-hold').value) : 0;
    var fadeIn     = parseInt(el('t-fadein') ? el('t-fadein').value : 0) || 0;
    var fadeOut    = parseInt(el('t-fadeout') ? el('t-fadeout').value : 0) || 0;
    var prefix     = el('t-name').value.trim() || 'Smart Lights';
    var gid = TModal._mkId();
    var list = [];

    function makeOnActs(brightness, mode) {
      var acts = lights.map(function(id) { return { type: 'turn_on', deviceId: id }; });
      lights.forEach(function(id) {
        var dimVal = (TModal._lightDims[id] && TModal._lightDims[id][mode] != null) ? TModal._lightDims[id][mode] : brightness;
        if (fadeIn > 0) {
          acts.push({ type: 'fade_to', deviceId: id, value: dimVal, duration: fadeIn });
        } else {
          acts.push({ type: 'set_dim', deviceId: id, value: dimVal });
        }
      });
      return acts;
    }

    // Day automation (motion + time condition)
    list.push({ id: TModal._mkId(), name: prefix + ' — Day', enabled: true,
      _groupId: gid, _groupName: prefix, _templateType: 'smart_dim',
      trigger: { type: 'motion_start', deviceId: sensor },
      conditions: [{ type: 'time_between', from: dayFrom, to: nightFrom }],
      actions: makeOnActs(dayBright, 'day') });

    // Night automation (motion + time condition)
    list.push({ id: TModal._mkId(), name: prefix + ' — Night', enabled: true,
      _groupId: gid, _groupName: prefix, _templateType: 'smart_dim',
      trigger: { type: 'motion_start', deviceId: sensor },
      conditions: [{ type: 'time_between', from: nightFrom, to: '23:59' }],
      actions: makeOnActs(nightBright, 'night') });

    // Off automation
    if (turnOff) {
      var offActsSD = lights.map(function(id) {
        return fadeOut > 0 ? { type: 'fade_off', deviceId: id, duration: fadeOut } : { type: 'turn_off', deviceId: id };
      });
      list.push({ id: TModal._mkId(), name: prefix + ' — OFF', enabled: true,
        _groupId: gid, _groupName: prefix, _templateType: 'smart_dim',
        _holdMinutes: hold,
        trigger: { type: 'motion_stop', deviceId: sensor }, conditions: [], actions: offActsSD });
    }
    return list;
  },

