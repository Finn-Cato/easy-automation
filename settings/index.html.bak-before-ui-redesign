        var modes = [
          { key: 'day',   label: '☀️ Day',   defEl: 't-day-bright',   defVal: 100 },
          { key: 'night', label: '🌙 Night', defEl: 't-night-bright', defVal: 20  }
        ];
        modes.forEach(function(m) {
          var globalVal = el(m.defEl) ? parseInt(el(m.defEl).value) : m.defVal;
          if (!TModal._lightDims[id]) TModal._lightDims[id] = {};
          if (TModal._lightDims[id][m.key] == null) TModal._lightDims[id][m.key] = globalVal / 100;
          if (TModal._prevGlobal[m.key] == null) TModal._prevGlobal[m.key] = globalVal;
          var pct = Math.round(TModal._lightDims[id][m.key] * 100);
          var sid = did + '_' + m.key, vid = sid + '_v';
