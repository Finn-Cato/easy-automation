<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Easy Automation</title>

  <script type="text/javascript" src="/homey.js" data-origin="settings"></script>
  <script>
    function onHomeyReady(Homey) {
      Homey.ready();
      window._hGet = function(key) {
        return new Promise(function(resolve, reject) {
          Homey.get(key, function(err, val) { err ? reject(new Error(String(err))) : resolve(val); });
        });
      };
      window._hSet = function(key, val) {
        return new Promise(function(resolve, reject) {
          Homey.set(key, val, function(err) { err ? reject(new Error(String(err))) : resolve(); });
        });
      };
      window._hAlert   = function(msg) { Homey.alert(msg); };
      window._hConfirm = function(msg) {
        return new Promise(function(res) { Homey.confirm(msg, null, function(e, ok) { res(ok); }); });
      };
      window._hBridge = async function(reqKey, resKey, payload, timeoutMs) {
        var ts = Date.now();
        await window._hSet(reqKey, JSON.stringify(Object.assign({ ts: ts }, payload)));
        var deadline = Date.now() + (timeoutMs || 10000);
        while (Date.now() < deadline) {
          await new Promise(function(r){ setTimeout(r, 400); });
          var raw = await window._hGet(resKey);
          if (!raw) continue;
          var res = typeof raw === 'string' ? JSON.parse(raw) : raw;
          if (res.reqTs === ts) return res;
        }
        throw new Error('Timeout waiting for response');
      };
      App.init();
    }
  </script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f2f2f7; color: #1c1c1e; font-size: 15px; }

    /* Top bar */
    .topbar { background: #fff; border-bottom: 1px solid #e0e0e5; padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 5; }
    .topbar h1 { font-size: 17px; font-weight: 700; }
    #status-msg { font-size: 12px; color: #8e8e93; min-width: 80px; text-align: right; }

    /* Tabs */
    .tabs { display: flex; background: #fff; border-bottom: 1px solid #e0e0e5; padding: 0 20px; }
    .tab { padding: 11px 16px; background: none; border: none; border-bottom: 2px solid transparent; font-size: 14px; font-weight: 600; color: #8e8e93; cursor: pointer; margin-bottom: -1px; }
    .tab.on { color: #007aff; border-bottom-color: #007aff; }

    /* Views */
    .view { display: none; padding: 20px; max-width: 640px; margin: 0 auto; }
    .view.on { display: block; }
    .sec-hdr { font-size: 13px; font-weight: 700; color: #8e8e93; text-transform: uppercase; letter-spacing: .5px; margin: 18px 0 10px; }

    /* Template cards */
    .templates { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 6px; }
    .tmpl-btn { background: #fff; border: 1.5px solid #e0e0e5; border-radius: 14px; padding: 16px 8px 14px; cursor: pointer; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; transition: border-color .15s, box-shadow .15s; }
    .tmpl-btn:hover { border-color: #007aff; box-shadow: 0 2px 12px rgba(0,122,255,.12); }
    .tmpl-icon { font-size: 30px; line-height: 1; }
    .tmpl-name { font-size: 12px; font-weight: 600; color: #1c1c1e; line-height: 1.3; }

    /* Automation cards */
    .auto-list-wrap { background: #fff; border-radius: 14px; box-shadow: 0 1px 6px rgba(0,0,0,.07); overflow: hidden; }
    .card { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid #f2f2f7; cursor: default; }
    .card:last-child { border-bottom: none; }
    .card-body { flex: 1; min-width: 0; cursor: pointer; padding: 2px 0; }
    .card-body:hover .card-name { color: #007aff; }
    .card-name { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color .15s; }
    .card-sub { font-size: 12px; color: #8e8e93; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-chevron { color: #c7c7cc; font-size: 16px; flex-shrink: 0; pointer-events: none; }
    .ico { background: none; border: none; cursor: pointer; color: #c7c7cc; font-size: 15px; padding: 4px 6px; border-radius: 6px; flex-shrink: 0; }
    .ico:hover { background: #fff0ef; color: #ff3b30; }
    .ico-run:hover { background: #e8f4ff !important; color: #007aff !important; }
    .ico-pause:hover { background: #f5eeff !important; color: #af52de !important; }
    .ico-pause.active { color: #af52de; }
    .ov-time-btn { flex: 1; padding: 10px 6px; border: 1.5px solid #e0e0e5; border-radius: 10px; background: #fafafa; font-size: 14px; font-weight: 600; cursor: pointer; text-align: center; transition: border-color .15s, background .15s; }
    .ov-time-btn:hover { border-color: #af52de; background: #f5eeff; color: #af52de; }
    .ov-resume-btn { width: 100%; padding: 10px; border: 1.5px solid #ff3b30; border-radius: 10px; background: #fff0ef; color: #ff3b30; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 12px; }
    .ov-resume-btn:hover { background: #ff3b30; color: #fff; }
    .light-grid { display: flex; flex-wrap: wrap; gap: 10px; padding: 14px; background: #f9f9f9; border-radius: 12px; margin-bottom: 14px; }
    .light-tile { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 64px; max-width: 88px; }
    .light-tile-icon { font-size: 28px; line-height: 1; }
    .light-tile-name { font-size: 11px; font-weight: 600; text-align: center; color: #1c1c1e; word-break: break-word; line-height: 1.2; }
    .light-tile-state { font-size: 11px; font-weight: 700; }

    /* Toggle */
    .tog { position: relative; width: 42px; height: 24px; flex-shrink: 0; }
    .tog input { opacity: 0; width: 0; height: 0; position: absolute; }
    .tog-track { position: absolute; inset: 0; background: #ccc; border-radius: 12px; cursor: pointer; transition: background .2s; }
    .tog-track::after { content: ''; position: absolute; width: 18px; height: 18px; background: #fff; border-radius: 50%; top: 3px; left: 3px; transition: transform .2s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
    .tog input:checked + .tog-track { background: #34c759; }
    .tog input:checked + .tog-track::after { transform: translateX(18px); }

    /* Buttons */
    .btn { padding: 9px 18px; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; transition: opacity .15s; }
    .btn:disabled { opacity: .4; cursor: not-allowed; }
    .btn-blue { background: #007aff; color: #fff; }
    .btn-blue:hover:not(:disabled) { background: #0062cc; }
    .btn-gray { background: #e5e5ea; color: #1c1c1e; }
    .btn-gray:hover:not(:disabled) { background: #d1d1d6; }

    /* Modal overlay */
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 50; overflow-y: auto; padding: 20px; }
    .overlay.on { display: flex; align-items: flex-start; justify-content: center; }
    .modal { background: #fff; border-radius: 16px; width: 100%; max-width: 480px; padding: 22px 24px 26px; margin: auto; box-shadow: 0 8px 40px rgba(0,0,0,.18); }
    .modal-hdr { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .modal-hdr h2 { font-size: 17px; font-weight: 700; }
    .modal-ftr { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; padding-top: 18px; border-top: 1px solid #e0e0e5; }
    .close-btn { background: none; border: none; cursor: pointer; color: #8e8e93; font-size: 20px; padding: 2px 6px; border-radius: 6px; }
    .close-btn:hover { background: #f2f2f7; }

    /* Form */
    .fgrp { margin-bottom: 14px; }
    .flabel { display: block; font-size: 11px; font-weight: 700; color: #8e8e93; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 5px; }
    .finput { width: 100%; padding: 9px 12px; border: 1.5px solid #e0e0e5; border-radius: 10px; font-size: 15px; color: #1c1c1e; background: #fafafa; outline: none; font-family: inherit; transition: border-color .15s; }
    .finput:focus { border-color: #007aff; background: #fff; }
    select.finput { cursor: pointer; }
    .sep { border: none; border-top: 1px solid #f0f0f5; margin: 16px 0; }

    /* Time row */
    .time-row { display: flex; gap: 10px; align-items: flex-end; }
    .time-row .fgrp { flex: 1; }

    /* Day-of-week selector */
    .day-row { display:flex; gap:6px; flex-wrap:wrap; }
    .day-btn { cursor:pointer; }
    .day-btn input { display:none; }
    .day-btn span { display:inline-block; padding:6px 10px; border-radius:8px; font-size:13px; font-weight:600; background:#f2f2f7; border:1.5px solid #e0e0e5; color:#8e8e93; transition:all 0.15s; }
    .day-btn input:checked + span { background:#007aff; border-color:#007aff; color:#fff; }

    /* Custom 24h time picker */
    .tp-wrap { display:inline-flex; align-items:center; gap:6px; user-select:none; }
    .tp-col  { display:flex; flex-direction:column; align-items:center; gap:3px; }
    .tp-btn  { width:40px; height:26px; background:#f2f2f7; border:1.5px solid #e0e0e5; border-radius:8px; font-size:12px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#1c1c1e; touch-action:manipulation; }
    .tp-btn:active { background:#dde0e8; }
    .tp-val  { font-size:18px; font-weight:700; color:#1c1c1e; background:#f2f2f7; border:1.5px solid #e0e0e5; border-radius:8px; padding:5px 0; width:40px; text-align:center; }
    .tp-sep  { font-size:20px; font-weight:700; color:#1c1c1e; margin-top:2px; }

    /* Brightness slider */
    .slider-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
    .slider-row input[type=range] { flex: 1; -webkit-appearance: none; height: 5px; background: #e0e0e5; border-radius: 3px; outline: none; cursor: pointer; }
    .slider-row input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; background: #007aff; border-radius: 50%; cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    .slider-val { font-size: 15px; font-weight: 700; color: #007aff; min-width: 42px; text-align: right; }

    /* Device picker */
    .dp-wrap { max-height: 200px; overflow-y: auto; border: 1.5px solid #e0e0e5; border-radius: 10px; background: #fafafa; }
    .dp-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; cursor: pointer; border-bottom: 1px solid #f2f2f7; }
    .dp-item:last-child { border-bottom: none; }
    .dp-item:hover { background: #f0f6ff; }
    .dp-item input[type=checkbox] { width: 18px; height: 18px; cursor: pointer; accent-color: #007aff; }
    .dp-name { font-size: 14px; flex: 1; }
    .dp-zone { font-size: 12px; color: #8e8e93; }
    .dp-empty { padding: 16px; text-align: center; color: #8e8e93; font-size: 13px; }
    .dp-grp { padding: 6px 12px 2px; font-size: 11px; font-weight: 700; color: #8e8e93; text-transform: uppercase; letter-spacing: .4px; background: #f2f2f7; }
    .dp-selall { font-size: 12px; color: #007aff; cursor: pointer; margin-top: 4px; display: inline-block; }

    /* Check row */
    .check-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
    .check-row input[type=checkbox] { width: 18px; height: 18px; accent-color: #007aff; cursor: pointer; }
    .check-row label { font-size: 14px; cursor: pointer; }

    /* Devices tab */
    .device-card { background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: 8px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; }
    .device-card-info { flex: 1; }
    .device-card-name { font-weight: 600; font-size: 14px; }
    .device-card-sub { font-size: 12px; color: #8e8e93; margin-top: 2px; }
    .badge { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 5px; background: #f0f6ff; color: #007aff; }

    /* Log */
    .log-row { display: flex; gap: 10px; padding: 8px 16px; border-bottom: 1px solid #f2f2f7; font-size: 13px; align-items: baseline; }
    .log-ts { color: #8e8e93; font-size: 11px; white-space: nowrap; flex-shrink: 0; }
    .log-lv { font-size: 10px; font-weight: 700; text-transform: uppercase; border-radius: 4px; padding: 2px 6px; flex-shrink: 0; width: 54px; text-align: center; }
    .log-lv.info { background: #e8f4fd; color: #2980b9; }
    .log-lv.error { background: #fde8e8; color: #ff3b30; }
    .log-lv.warn { background: #fef3e2; color: #ff9500; }
    .log-lv.trigger { background: #e8fded; color: #27ae60; }
    .log-lv.action { background: #f3e8fd; color: #8e44ad; }
    .log-lv.skipped { background: #f2f2f7; color: #8e8e93; }
    .log-lv.test { background: #fef3e2; color: #ff9500; }
    .log-msg { flex: 1; }

    .loader { text-align: center; padding: 36px; color: #8e8e93; font-size: 14px; }
    .empty { text-align: center; padding: 40px 20px; color: #8e8e93; }
    .empty .icon { font-size: 36px; margin-bottom: 10px; }
    .empty p { font-size: 14px; line-height: 1.7; }
    .row-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .row-top h2 { font-size: 16px; font-weight: 700; }

    /* Modal inner tabs */
    .modal-tab { background: none; border: none; border-bottom: 2px solid transparent; padding: 9px 16px; font-size: 13px; font-weight: 600; color: #8e8e93; cursor: pointer; margin-bottom: -1px; font-family: inherit; }
    .modal-tab.on { color: #007aff; border-bottom-color: #007aff; }

    /* Lights tab */
    .lt-card { padding: 14px 16px; border-bottom: 1px solid #f2f2f7; }
    .lt-card:last-child { border-bottom: none; }
    .lt-name { font-weight: 600; font-size: 14px; margin-bottom: 10px; color: #1c1c1e; }
    .lt-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .lt-row:last-child { margin-bottom: 0; }
    .lt-label { font-size: 11px; font-weight: 700; color: #8e8e93; width: 56px; flex-shrink: 0; }
  </style>
</head>
<body>

<div class="topbar">
  <h1>Easy Automation</h1>
  <span id="status-msg"></span>
</div>

<div class="tabs">
  <button class="tab on"  id="tab-auto"    onclick="UI.tab('auto')">Automations</button>
  <button class="tab"     id="tab-devices" onclick="UI.tab('devices')">Devices</button>
  <button class="tab"     id="tab-logs"    onclick="UI.tab('logs')">Logs</button>
</div>

<!-- Automations -->
<div class="view on" id="view-auto">
  <div class="sec-hdr">Add new automation</div>
  <div class="templates">
    <button class="tmpl-btn" onclick="TModal.open('motion_lights')">
      <span class="tmpl-icon">🏃</span>
      <span class="tmpl-name">Motion<br>→ Lights</span>
    </button>
    <button class="tmpl-btn" onclick="TModal.open('smart_dim')">
      <span class="tmpl-icon">🌙</span>
      <span class="tmpl-name">Smart Dim<br>Day / Night</span>
    </button>
    <button class="tmpl-btn" onclick="TModal.open('door_lights')">
      <span class="tmpl-icon">🚪</span>
      <span class="tmpl-name">Door<br>→ Lights</span>
    </button>
    <button class="tmpl-btn" onclick="TModal.open('schedule')">
      <span class="tmpl-icon">⏰</span>
      <span class="tmpl-name">Schedule<br>Lights</span>
    </button>
    <button class="tmpl-btn" onclick="TModal.open('switch')">
      <span class="tmpl-icon">🔘</span>
      <span class="tmpl-name">Wall Switch<br>/ Button</span>
    </button>
    <button class="tmpl-btn" onclick="TModal.open('custom')">
      <span class="tmpl-icon">⚙️</span>
      <span class="tmpl-name">Custom<br>Advanced</span>
    </button>
  </div>

  <div class="sec-hdr">My automations</div>
  <div id="auto-list"><div class="loader">Loading…</div></div>
</div>

<!-- Devices tab -->
<div class="view" id="view-devices">
  <div class="row-top">
    <h2>Cached Devices</h2>
    <button class="btn btn-blue" id="btn-refresh-dev" onclick="DevTab.refresh()">Refresh</button>
  </div>
  <div id="device-list"><div class="loader">Loading…</div></div>
</div>


<!-- Test tab -->

<!-- Logs tab -->
<div class="view" id="view-logs">
  <div class="row-top">
    <h2>Activity Log</h2>
    <div style="display:flex;gap:8px">
      <button class="btn btn-gray" onclick="LogTab.copy()">Copy Log</button>
      <button class="btn btn-gray" onclick="LogTab.load()">Refresh</button>
    </div>
  </div>
  <div class="card" style="padding:0;overflow:hidden">
    <div style="width:100%" id="log-list"><div class="loader">Loading…</div></div>
  </div>
</div>

<!-- Override modal -->
<div class="overlay" id="ov-overlay" onclick="OverrideModal.bgClose(event)">
  <div class="modal" style="max-width:360px">
    <div class="modal-hdr">
      <h2 id="ov-title" style="font-size:16px">Pause automation</h2>
      <button class="close-btn" onclick="OverrideModal.close()">✕</button>
    </div>
    <p style="font-size:13px;color:#8e8e93;margin-bottom:14px">Triggers are paused — lights stay as you set them manually. Automation resumes when the override expires.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
      <button class="ov-time-btn" onclick="OverrideModal.set(30)">⏸ 30 min</button>
      <button class="ov-time-btn" onclick="OverrideModal.set(60)">⏸ 1 hour</button>
      <button class="ov-time-btn" onclick="OverrideModal.set(120)">⏸ 2 hours</button>
      <button class="ov-time-btn" onclick="OverrideModal.set(240)">⏸ 4 hours</button>
    </div>
    <button class="ov-time-btn" style="width:100%;margin-top:8px" onclick="OverrideModal.setMidnight()">🌙 Until midnight</button>
    <div id="ov-resume-wrap" style="display:none">
      <hr class="sep" style="margin:14px 0">
      <div style="font-size:12px;color:#af52de;font-weight:600;margin-bottom:8px" id="ov-active-label"></div>
      <button class="ov-resume-btn" onclick="OverrideModal.cancel()">▶ Resume automation now</button>
    </div>
  </div>
</div>

<!-- Template / Custom modal -->
<div class="overlay" id="tmpl-overlay" onclick="TModal.overlayClick(event)">
  <div class="modal" id="tmpl-modal">
    <div class="modal-hdr">
      <h2 id="tmpl-title">Add Automation</h2>
      <button class="close-btn" onclick="TModal.close()">✕</button>
    </div>
    <div id="tmpl-inner-tabs" style="display:none;border-bottom:1px solid #e0e0e5;margin:0 -24px 16px;padding:0 24px">
      <button id="tmpl-tab-settings" class="modal-tab on" onclick="TModal._modalTab('settings')">⚙️ Settings</button>
      <button id="tmpl-tab-lights"   class="modal-tab"    onclick="TModal._modalTab('lights')">💡 Lights</button>
      <button id="tmpl-tab-test"     class="modal-tab"    onclick="TModal._modalTab('test')">🧪 Test</button>
    </div>
    <div id="tmpl-settings-tab">
      <div id="tmpl-body"></div>
    </div>
    <div id="tmpl-lights-tab" style="display:none;margin:0 -24px;padding:0 24px 4px;max-height:55vh;overflow-y:auto"></div>
    <div id="tmpl-test-tab"   style="display:none;padding:4px 0 8px"></div>
    <div class="modal-ftr" id="tmpl-ftr">
      <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer">
        <input type="checkbox" id="tmpl-enabled" checked> Active
      </label>
      <div style="display:flex;gap:8px;margin-left:auto">
        <button class="btn btn-gray" onclick="TModal.close()">Cancel</button>
        <button class="btn btn-blue" id="tmpl-save-btn" onclick="TModal.save()">Add</button>
      </div>
    </div>
  </div>
</div>

<script>
'use strict';

var el = function(id) { return document.getElementById(id); };
function esc(s) {
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function setStatus(msg, t) {
  el('status-msg').textContent = msg;
  if (t) setTimeout(function() { el('status-msg').textContent = ''; }, t);
}

// ── State ──────────────────────────────────────────────────────────────────────
var State = { devices: [], automations: [], holdStatus: {}, overrides: {} };

// ── API (settings-based, works on permanent install) ──────────────────────────
var API = {
  getDevices: function() {
    return window._hGet('_deviceCache').then(function(v) {
      return v ? (typeof v === 'string' ? JSON.parse(v) : v) : [];
    });
  },
  getAutomations: function() {
    return window._hGet('automations').then(function(v) {
      return v ? (typeof v === 'string' ? JSON.parse(v) : v) : [];
    });
  },
  saveAutomations: function(list) {
    return window._hSet('automations', JSON.stringify(list));
  }
};

// ── App init ───────────────────────────────────────────────────────────────────
var App = {
  init: async function() {
    try {
      var res = await Promise.all([API.getDevices(), API.getAutomations()]);
      State.devices     = Array.isArray(res[0]) ? res[0] : [];
      State.automations = Array.isArray(res[1]) ? res[1] : [];
      AutoList.render();
      DevTab.render();
    } catch(e) {
      el('auto-list').innerHTML = '<div class="loader" style="color:#ff3b30">Load error: ' + e.message + '</div>';
    }
    // Load hold status and overrides once on init
    window._hGet('_holdStatus').then(function(raw) {
      State.holdStatus = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : {};
    }).catch(function(){});
    window._hGet('_overrides').then(function(raw) {
      State.overrides = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : {};
    }).catch(function(){});
    // Ticker: update countdown display every second
    setInterval(function() { Countdown.tick(); }, 1000);
    // Sync hold status and overrides from backend every 8 seconds
    setInterval(function() {
      window._hGet('_holdStatus').then(function(raw) {
        State.holdStatus = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : {};
