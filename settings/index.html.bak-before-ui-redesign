              '<input type="range" id="' + sid + '" min="1" max="100" value="' + pct + '"' +
                ' oninput="document.getElementById(\'' + vid + '\').textContent=this.value+\'%\';TModal._setLightDim(' + JSON.stringify(id) + ',' + JSON.stringify(m.key) + ',parseInt(this.value))">' +
              '<span class="slider-val" id="' + vid + '">' + pct + '%</span>' +
